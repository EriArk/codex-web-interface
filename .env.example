# Example only. Never commit real secret values.

# Hub session/auth secret material. Generate a long random value in production.
CODEX_WEB_SESSION_SECRET=replace-me

# Initial/bootstrap password can be supplied during first-run setup instead of
# remaining in the environment permanently. Exact bootstrap flow is implemented
# during Phase 1.
CODEX_WEB_BOOTSTRAP_PASSWORD=replace-me

# Example Remote Desktop secret referenced by config.example.yaml.
REMOTE_MAIN_WINDOWS_PASSWORD=replace-me

# Optional overrides.
# CODEX_WEB_CONFIG=/etc/codex-web/config.yaml
# CODEX_WEB_LOG_LEVEL=info
