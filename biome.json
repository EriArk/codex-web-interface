{
  "files": {
    "includes": [
      "apps/**",
      "packages/**",
      "tests/**",
      "!**/dist/**",
      "!apps/web/public/vendor/**"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
